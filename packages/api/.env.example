# packages/api environment variables
# Copy to packages/api/.env for local development.

DATABASE_URL=postgres://recetario:recetario@localhost:5432/recetario
JWT_SECRET=dev-secret-change-in-production
DEV_API_KEY=
# Per-IP limit on POST /auth/login + /auth/register per minute (default 10).
# Raise only for E2E/CI, which log in before every test from one IP.
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
